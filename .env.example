# Required for stable sessions/CSRF tokens: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Left unset, the app generates a random key per process instead of using a known one.
SECRET_KEY=
DATABASE_URL=
AI_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3
GEMINI_API_KEY=
PORT=5001
# Loopback-only by default. Serving on any other interface requires
# FLASK_DEBUG off (default) and AUTH_PASSWORD_HASH/AUTH_PASSWORD set.
HOST=127.0.0.1
FLASK_DEBUG=0
# HTTP Basic credentials guarding every route (scan submission + results).
# Prefer a hash: python -c "from werkzeug.security import generate_password_hash as g; print(g('yourpassword'))"
AUTH_USERNAME=sentinel
AUTH_PASSWORD_HASH=
AUTH_PASSWORD=
# Allow scanning loopback/private targets (e.g. http://localhost:3000). Off by
# default so a submitted URL can't be used to reach internal-only services.
ALLOW_PRIVATE_TARGETS=false
# Set to false to skip the AI-generated executive summary in the report
# (useful if Ollama isn't running -- the pipeline degrades gracefully either way).
AI_ANALYSIS_ENABLED=true
