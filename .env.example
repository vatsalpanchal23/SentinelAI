# SentinelAI — local environment
# Copy this file to ".env" and fill in your key.
#
# The scanner itself (DNS, Certificate Transparency, HTTP probing, headers,
# cookies, exposed paths, scoring) works with NO key at all.
# A key is only needed for the "AI Analysis" tab.

# --- Option A: OpenAI ---
AI_API_KEY=sk-your-openai-key
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# --- Option B: OpenRouter (access to Gemini/Claude/etc.) ---
# AI_API_KEY=sk-or-your-openrouter-key
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_MODEL=google/gemini-2.5-flash

# --- Option C: Local Ollama (no key needed, any placeholder works) ---
# AI_API_KEY=ollama
# AI_BASE_URL=http://localhost:11434/v1
# AI_MODEL=llama3.1
